rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) { 
        return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isValidUser(data) {
        return data.keys().hasAll(['name', 'email', 'createdAt', 'updatedAt']) 
            && data.keys().size() == 4
            && data.name is string && data.name.size() > 0 && data.name.size() <= 100
            && data.email is string && data.email.size() > 0 && data.email.size() <= 200
            && data.createdAt == request.time
            && data.updatedAt == request.time;
    }

    function isValidInsight(data) {
        return data.keys().hasAll(['readingId', 'insightKey', 'text', 'createdAt', 'updatedAt'])
            && data.keys().size() == 5
            && data.readingId is string && data.readingId.size() > 0 && data.readingId.size() <= 128
            && data.insightKey is string && data.insightKey.size() > 0 && data.insightKey.size() <= 128
            && data.text is string && data.text.size() > 0 && data.text.size() <= 20000
            && data.createdAt == request.time
            && data.updatedAt == request.time;
    }

    function isValidNote(data) {
        return data.keys().hasAll(['readingId', 'positionId', 'text', 'updatedAt'])
            && data.keys().size() == 4
            && data.readingId is string && data.readingId.size() > 0 && data.readingId.size() <= 128
            && data.positionId is string && data.positionId.size() > 0 && data.positionId.size() <= 128
            && data.text is string && data.text.size() > 0 && data.text.size() <= 10000
            && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isSignedIn() 
        && isValidId(userId) 
        && request.auth.uid == userId 
        && isValidUser(incoming());
      
      allow update: if isSignedIn() 
        && isValidId(userId) 
        && request.auth.uid == userId 
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) 
        && incoming().email == existing().email 
        && incoming().createdAt == existing().createdAt;
            
      allow list: if false;
      allow delete: if false;

      match /insights/{insightId} {
        allow read, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(insightId)
          && isValidInsight(incoming());

        allow update: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(insightId)
          && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 20000
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt'])
          && incoming().readingId == existing().readingId
          && incoming().insightKey == existing().insightKey
          && incoming().createdAt == existing().createdAt;

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /notes/{noteId} {
        allow read, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(noteId)
          && isValidNote(incoming());

        allow update: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(noteId)
          && isValidNote(incoming())
          && incoming().readingId == existing().readingId
          && incoming().positionId == existing().positionId;

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
